# ==============================================================================
# Institute of Da'wa Islamiyya (IDI) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
PORT=5500
SITE_URL=http://localhost:5500

# ------------------------------------------------------------------------------
# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (CONFIDENTIAL: Never expose to browser/client-side code)
# Used only for privileged backend scripts, CLI maintenance, or migration automations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Institutional Information & Contact
# ------------------------------------------------------------------------------
INSTITUTION_NAME="Institute of Da'wa Islamiyya"
CONTACT_EMAIL=info@idi.edu
ADMISSIONS_EMAIL=admissions@idi.edu
CONTACT_PHONE="+1 234 567 890"

# ------------------------------------------------------------------------------
# Resend Email Integration & Webhooks
# Found in Resend Dashboard -> API Keys & Webhooks (https://resend.com)
# ------------------------------------------------------------------------------
# Resend API Key (CONFIDENTIAL: Never expose to browser/client-side code)
RESEND_API_KEY=re_your_resend_api_key_here

# Resend Sending Domain (e.g., yourdomain.lk or idi.lk)
RESEND_DEFAULT_FROM_DOMAIN=idi.lk

# Resend Inbound Webhook Signing Secret (or header verification token)
RESEND_INBOUND_WEBHOOK_SECRET=whsec_your_inbound_webhook_secret_here

# Resend Delivery Status Webhook Signing Secret
RESEND_DELIVERY_WEBHOOK_SECRET=whsec_your_delivery_webhook_secret_here
